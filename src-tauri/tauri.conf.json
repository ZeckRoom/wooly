{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wooly Launcher",
  "version": "../package.json",
  "identifier": "net.wooly.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wooly Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#161310"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https://mc-heads.net https://crafatar.com; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Wooly",
    "shortDescription": "Minecraft Java Edition launcher",
    "category": "Game",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Wooly Launcher"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
