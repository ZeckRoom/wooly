{
  "name": "wooly-launcher",
  "version": "0.1.0",
  "description": "Wooly Launcher — a standalone Minecraft Java Edition launcher for Windows.",
  "author": "Wooly",
  "homepage": "https://github.com/ZeckRoom/wooly",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:win": "tauri build --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@stylexjs/stylex": "^0.17.4",
    "@tauri-apps/api": "^2.9.0",
    "gsap": "^3.15.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylexjs/unplugin": "^0.17.4",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.24.0"
}
